#include <windows.h>

// Application Icon
IDI_ICON1 ICON DISCARDABLE "otcicon.ico"

// Application Manifest (1 = RT_MANIFEST)
1 RT_MANIFEST "app.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Peter99py\0"
            VALUE "FileDescription",  "Otclient lp\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "otclient\0"
            VALUE "LegalCopyright",   "Copyright (c) 2010-2026 OTClient & Peter99py (MIT License)\0"
            VALUE "OriginalFilename", "otclient.exe\0"
            VALUE "ProductName",      "otclient lp\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
